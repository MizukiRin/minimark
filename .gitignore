# ==============================================================================
# MiniMark - Git Ignore Configuration
# ==============================================================================

# --- Python 编译与字节码缓存 ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
*.dist-info/
.pytest_cache/

# --- Python 虚拟环境 ---
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# --- 文档与私有设计 (可选) ---
doc/

# --- PyInstaller 构建临时文件与发布包 ---
build/
dist/
release/
*.manifest
*.spec.bak
*.exe
*.zip
*.7z
*.tar.gz
*.lnk
localpycs/

# --- 本地应用数据与运行时临时存储 ---
MiniMark/
MiniMark_Lite/
storage/
temp/
*.tmp

# --- IDE 与编辑器配置文件 ---
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# --- 操作系统临时文件 ---
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/
*.lnk

# --- 日志与环境密钥文件 ---
*.log
.env
.env.*
